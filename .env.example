# Synthetic demo needs no credentials. Never commit real patient data or API secrets.
# API defaults to 127.0.0.1:3001; web defaults to 127.0.0.1:5173.

# --- EHS assistant service (optional separate process) ---
# Port for the standalone assistant service (apps/assistant). Defaults to 3002.
# ASSISTANT_PORT=3002

# --- Live audio transcription (optional; server-side only) ---
# If unset, /transcribe returns an explicit "unavailable" state and text entry still works.
# The value is a secret: set it in your shell/host env, never commit it.
# SCENEBRIEF_TRANSCRIBE_API_KEY=
# Provider for that key. Supported: "openai" (default). Not a secret.
# SCENEBRIEF_TRANSCRIBE_PROVIDER=openai
# Optional: model (default whisper-1) and an OpenAI-compatible base URL.
# SCENEBRIEF_TRANSCRIBE_MODEL=whisper-1
# SCENEBRIEF_TRANSCRIBE_BASE_URL=https://api.openai.com/v1
